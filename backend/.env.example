# CognoDB connection details (from console.cognodb.com)
# Example URI form: bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_USERNAME=cognodb
NEO4J_PASSWORD=<your-generated-password>

# Backend server
PORT=4000

# Frontend origin allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5174
